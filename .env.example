# Copy to .env and fill in. Generate a key with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CHEST_PORT=8000
# Public URL, used for "View in Chest" links in Slack posts
CHEST_PUBLIC_URL=http://localhost:8000

# --- Slack (optional; both directions off by default) ---
# Bot token scopes: channels:history (or groups:history for a private
# channel) and chat:write. Invite the bot to the channel.
SLACK_BOT_TOKEN=
# Channel ID (e.g. C0123456789), not the #name
SLACK_CHANNEL_ID=
# Import tools from GitHub links posted in the channel
SLACK_IMPORT_ENABLED=False
# Post tools added through the web UI to the channel
SLACK_POST_ENABLED=False
# Seconds between channel polls
SLACK_POLL_INTERVAL=900
